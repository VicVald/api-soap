# =============================================================================
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e altere os valores conforme sua necessidade.
# =============================================================================

# Configurações do Servidor HTTP / Uvicorn
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Configurações de Segurança e Autenticação
# Chave de API utilizada para autorização no header 'X-API-Key' ou 'Authorization: Bearer <token>'
API_KEY=soap-secret-key-2026

# Configurações de Rate Limiting por IP (Prevenção de Ataques DoS / Brute-Force)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Integração Externa com ViaCEP
VIACEP_BASE_URL=https://viacep.com.br/ws
HTTP_TIMEOUT_SECONDS=10.0
